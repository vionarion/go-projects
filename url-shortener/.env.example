# Copy to .env and fill in. The real .env is ignored by git.
APP_PORT=:3000
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=change-me
# Public host of the service; links to it are rejected to avoid redirect loops
DOMAIN=localhost:3000
# Shorten requests per client IP per window
API_QUOTA=10
API_QUOTA_WINDOW_MIN=30
DEFAULT_EXPIRY_HOURS=24
MAX_EXPIRY_HOURS=720
CODE_LENGTH=7
# Set to true behind Traefik/nginx so the client IP is taken from X-Forwarded-For
TRUST_PROXY=false
